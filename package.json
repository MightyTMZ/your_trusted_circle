{
  "name": "your_trusted_companion",
  "version": "1.0.0",
  "description": "YTC — opt-in buddy system prototype (Project KAZE, HTV XI). Simulation only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.node.json",
    "start": "node dist/src/server/main.js",
    "preview": "vite preview",
    "test": "vitest run && npm run test:node",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "agent:demo": "vite-node src/agent/demo.ts",
    "server": "npm run build:server && node --env-file-if-exists=.env build/server/src/server/main.js",
    "build:server": "tsc -p tsconfig.server.json",
    "dev:full": "node scripts/dev.mjs",
    "test:node": "tsc -p tsconfig.node.json && node --test --test-reporter=dot \"dist/test/**/*.test.js\"",
    "examples": "tsc -p tsconfig.node.json && node dist/src/timeline/fixtures/no-response.js docs/examples data/examples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MightyTMZ/your_trusted_companion.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MightyTMZ/your_trusted_companion/issues"
  },
  "homepage": "https://github.com/MightyTMZ/your_trusted_companion#readme",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@hono/node-server": "^2.1.5",
    "@tensorflow/tfjs": "^4.22.0",
    "arctic": "^3.7.0",
    "hono": "^4.13.13",
    "mongodb": "^7.7.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "private": true,
  "type": "module",
  "allowScripts": {
    "protobufjs@7.6.6": true
  }
}
