# Copy to .env (git-ignored) and fill in. Never commit real secrets.
# Start the API with: npm run server   (the web app proxies /api to it in dev)

PORT=8787
# Origin of the web app. In dev the API is reached through Vite's /api proxy.
APP_ORIGIN=http://localhost:5173
# Public origin used to build OAuth redirect URIs: <API_ORIGIN>/api/auth/<provider>/callback
API_ORIGIN=http://localhost:5173
# true outside local http development. Apple sign-in requires https.
COOKIE_SECURE=false

# Leave empty to use an in-memory store (data is lost on restart).
MONGODB_URI=
MONGODB_DB=ytc
RETENTION_DAYS=30

# A provider is enabled only when all of its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple: Services ID, team, key id, and the .p8 key as one line with \n.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Microsoft Entra ID. "common" accepts personal and work accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Simulated voice-agent calls (/api/calls, operator console at /#operator).
# Without GEMINI_API_KEY the agent reads facts verbatim; without
# ELEVENLABS_API_KEY the call is text only. The key needs speech-to-text and
# text-to-speech access only. ELEVENLABS_VOICE_ID is optional.
# Live incident demo (Demo > Incident demo, host only). Also on with TEST_SIGN_IN on localhost.
DEMO_INCIDENTS=false

GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Voice-agent service (box 4). Both empty: the emergency step is recorded as simulated only.
VOICE_AGENT_URL=
VOICE_AGENT_TOKEN=

# Serverless hosts (Vercel): see docs/backend.md "Deploying".
CRON_SECRET=
TICK_ON_REQUEST=false
TRUST_PROXY=false
# Set to false once the Python pruning job (pipelines/) runs on a schedule.
RETENTION_IN_API=true

# Group map. A browser key for the Maps JavaScript API, restricted to your
# app's origins in Google Cloud. Injected at build time via vite.config.ts. Without it the
# group map shows the synthetic venue plot instead of satellite imagery.
GOOGLE_MAPS_API_KEY=
# Optional map ID (needed for advanced markers). Defaults to DEMO_MAP_ID.
GOOGLE_MAPS_MAP_ID=
# Optional default demo venue for simulated people: "lat,lng" or "lat,lng|Name".
# Presenters can also set it from the Demo panel (an address needs the
# Geocoding API enabled on the Maps key). Use a public place.
DEMO_VENUE=

# Development only: password-free test sign-in with made-up names, for trying
# the app with several people on one computer (open localhost:5173 and
# 127.0.0.1:5173 as two "phones"). Ignored unless APP_ORIGIN is localhost and
# NODE_ENV is not production.
TEST_SIGN_IN=
